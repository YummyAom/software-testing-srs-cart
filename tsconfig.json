{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@cart/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@cart/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@cart/api": [
        "./backend/src/index.ts"
      ]
    }
  },
  "include": [
    "backend/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ]
}
