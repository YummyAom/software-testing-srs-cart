# Shared root .env for local APIs. Do not commit actual credentials.
# npm run dev: mock cart API; npm run dev:auth: Supabase login-only API.
# Both default to port 3000; run only one at a time or override API_PORT.
APP_ENV=development
API_PORT=3000
# Configure an exact origin if the API owner enables CORS.
UI_ORIGIN=http://localhost:5173
# Test-only synthetic values, not specified by SRS (SOI-01).
SEED_PASSWORD_CUSTOMER_NORMAL=cart-test-only-password
SEED_PASSWORD_CUSTOMER_PRIME=cart-test-only-password
SEED_PASSWORD_ADMIN=cart-test-only-password
# Mock API enables reset only with APP_ENV=test; never use remotely.
TEST_RESET_TOKEN=local-test-reset-only

# Required only for the separate Supabase login API (npm run dev:auth).
# Not frontend VITE_* variables; these are read by backend/src/config.ts.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
