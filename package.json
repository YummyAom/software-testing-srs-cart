{
  "name": "srs-cart-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/domain",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "npm run dev --workspace @cart/api",
    "start": "npm run start --workspace @cart/api",
    "dev:auth": "npm --prefix backend run dev",
    "build:auth": "tsc --build backend/tsconfig.build.json",
    "start:auth": "npm --prefix backend run start",
    "typecheck": "tsc --project tsconfig.json",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:service": "vitest run --project service",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
