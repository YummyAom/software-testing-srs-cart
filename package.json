{
  "name": "srs-cart-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "packages/domain",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "npm run dev --workspace @cart/api",
    "start": "npm run start --workspace @cart/api",
    "typecheck": "tsc --project tsconfig.json",
    "build": "tsc --build tsconfig.build.json",
    "db:local:reset": "npx --yes supabase@2.117.0 db reset --local",
    "db:local:seed": "node --env-file-if-exists=backend/.env.test backend/scripts/local-supabase-seed.mjs",
    "dev:test": "npm exec --workspace @cart/api -- tsx watch --env-file=.env.test src/index.ts",
    "e2e:setup": "node scripts/run-tests.mjs setup",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:api": "node scripts/run-tests.mjs api",
    "e2e": "node scripts/run-tests.mjs e2e",
    "e2e:report": "node scripts/run-tests.mjs report",
    "e2e:stop": "node scripts/run-tests.mjs stop"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
