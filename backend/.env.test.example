# Copy to backend/.env.test (git-ignored) and fill the <...> values. Local Supabase stack only.
# Run `supabase status` from the repo root to read the API URL, keys and DB URL.
APP_ENV=test
API_PORT=3001
UI_ORIGIN=http://localhost:5173
# Ports come from supabase/config.toml (55321 API, 55322 DB), not the Supabase defaults.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<paste anon/publishable key from `supabase status`>
LOCAL_SUPABASE_SERVICE_ROLE_KEY=<paste service_role key from `supabase status`>
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
TEST_RESET_TOKEN=change-me-test-only
# Used by `npm run db:local:seed` (at least 6 characters each).
SEED_PASSWORD_CUSTOMER_NORMAL=<choose a local password>
SEED_PASSWORD_CUSTOMER_PRIME=<choose a local password>
SEED_PASSWORD_ADMIN=<choose a local password>
